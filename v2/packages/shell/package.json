{
  "name": "@hbc/shell",
  "version": "1.0.0",
  "private": true,
  "description": "App shell — navigation, layout, project picker, command palette, status bar",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@hbc/models": "workspace:*",
    "@hbc/auth": "workspace:*",
    "@hbc/ui-kit": "workspace:*",
    "@fluentui/react-components": "^9.46.0",
    "@fluentui/react-icons": "2.0.319",
    "zustand": "^5.0.0",
    "@tanstack/react-router": "^1.161.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
